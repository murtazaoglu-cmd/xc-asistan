# X Control Yapı API — örnek ortam değişkenleri (kopyalayın: cp .env.example .env)
PORT=4000
NODE_ENV=production
DATABASE_URL=postgresql://xcontrol_user:GUCLU_BIR_SIFRE@localhost:5432/xcontrol_db
DATABASE_SSL=false
# DB_SSL_REJECT_UNAUTHORIZED=true   # DATABASE_SSL=true iken sunucu sertifikasını doğrula (varsayılan false = eski davranış)
# DB_SSL_CA=/etc/ssl/db-ca.pem      # özel CA (verilirse doğrulama varsayılan açılır)

# Oturum — JWT_SECRET en az 32 karakter önerilir (openssl rand -hex 32); 16 altı sunucuyu başlatmaz
JWT_SECRET=
JWT_EXPIRES_IN=7d            # web paneli
JWT_EXPIRES_IN_MOBILE=30d    # mobil uygulama (login'de client:"mobile")

APP_URL=https://api.controlx.com.tr
SITE_URL=https://controlx.com.tr
UPLOAD_DIR=./uploads

# E-posta (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="X Control Yapı <info@controlx.com.tr>"
MAIL_TO_ADMIN=info@controlx.com.tr

# WhatsApp Cloud API (Meta)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
ADMIN_WHATSAPP_NUMBER=
# WHATSAPP_API_BASE=          # yalnızca test (sahte sunucu); boş bırakın

# Web Push (VAPID): npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- v16 güvenlik sertleştirme (README bölüm 14) ---
HOST=127.0.0.1                 # API yalnız yerel ters proxy'den erişilsin
TRUST_PROXY=1                  # önündeki güvenilir proxy sayısı (nginx=1, Cloudflare+nginx=2, yok=false)
# Tarayıcıdan API'ye istek atan TÜM kökenler (virgülle, sonda / olmadan): web paneli + herkese açık teklif formu olan üç site (www dahil).
# Mobil uygulama (Flutter) CORS kullanmaz. Eksik köken = o sitenin teklif formu tarayıcıda sessizce başarısız olur.
CORS_ORIGINS=https://panel.controlx.com.tr,https://controlx.com.tr,https://www.controlx.com.tr,https://x-metal.tr,https://www.x-metal.tr,https://nicebodrum.com,https://www.nicebodrum.com
# JWT_SECRET_STRICT=true       # 32 karakterden kısa JWT_SECRET'te başlatma
# UPLOAD_SIGN_SECRET=          # dosya bağlantı imza anahtarı (boşsa JWT_SECRET'ten türetilir)
# UPLOAD_URL_TTL_SEC=600       # imzalı dosya bağlantısı ömrü
# AUTH_CACHE_TTL_MS=10000      # kullanıcı durumu önbelleği (en çok 30000)
# PASSWORD_MIN_LENGTH=8        # yeni şifre alt sınırı (varsayılan 6)
# BCRYPT_ROUNDS=12
# PUSH_ENDPOINT_HOSTS=         # ek izinli web-push alan adları (virgüllü)
# RATE_LIMIT_API_MAX=3000      # IP başına 15 dk genel API sınırı (0=kapalı)

# --- v17 asistan altyapısı (README bölüm 15) — hepsi opsiyonel ---
# FCM_SERVICE_ACCOUNT_FILE=/etc/xcontrol/fcm.json   # Firebase servis hesabı anahtarı; yoksa FCM kapalı (bildirimler uygulama içi kutuda)
# FCM_SERVICE_ACCOUNT_JSON=                          # alternatif: ham JSON ya da base64
# WORKER_TICK_MS=30000
# WORKER_BATCH=20
# WORKER_STALE_SECONDS=120      # /api/health/worker eşiği
# APP_MIN_VERSION=              # /config → zorunlu güncelleme bilgisi (ör. 1.0.0)
# APP_LATEST_VERSION=
# APP_STORE_URL_ANDROID=
# APP_STORE_URL_IOS=
# MAINTENANCE_MODE=false

# --- v19: komut çubuğu ve yazışma içe aktarma (hepsi isteğe bağlı) ---
# IMPORT_MAX_UPLOAD_MB=25
# IMPORT_MAX_MESSAGES=200000
# IMPORT_RATE_MAX=20
# IMPORT_RETENTION_DAYS=730
# IMPORT_RAW_TEXT_DAYS=180
# ASSISTANT_RAW_TEXT_DAYS=30
# ASSISTANT_UNDO_WINDOW_SEC=600

# --- v18: mesaj şablonlarında {firma_adi} {telefon} {iban_unvan} değişkenleri (isteğe bağlı; yoksa gövdeden/kuruluş adından alınır) ---
# COMPANY_NAME="X Control Yapı"
# COMPANY_PHONE="0 5xx xxx xx xx"
# COMPANY_IBAN_INFO="X Control Yapı — TR00 0000 0000 0000 0000 0000 00"

# --- v19/v20 gelişmiş (varsayılanlar yeterlidir; yalnız gerektiğinde açın) ---
# ASSISTANT_INTERNAL_BASE=http://127.0.0.1:4000   # komut çubuğu onayının kendi API'sine döngü-içi çağrı adresi (varsayılan: gelen bağlantının yerel adresi)
# FCM_PROJECT_ID=                                  # servis hesabındaki project_id'yi ezmek için (nadiren)
# JOB_LOCK_TIMEOUT_MS=300000                       # çöken worker'ın işini kurtarma süresi
# JOB_TIMEOUT_MS=60000                             # tek işin azami süresi
# PLAN_EXPIRES_AFTER_MS=12600000                   # brifing/kapanış işinin "kaçırıldı" sayılma süresi (3,5 sa)

# --- YALNIZ TEST: ASSISTANT_FAKE_NOW (sahte saat) ve WHATSAPP_API_BASE/FCM_API_BASE üretimde ASLA tanımlamayın. ---
# (ASSISTANT_FAKE_NOW, NODE_ENV=production iken zaten yok sayılır.)
