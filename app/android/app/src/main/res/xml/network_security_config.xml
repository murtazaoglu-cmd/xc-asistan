<?xml version="1.0" encoding="utf-8"?>
<!-- Yalnızca https: düz http (cleartext) trafiği tüm alan adları için kapalı. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
